{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    // Vitest setup/helpers are glob-loaded and expose test APIs.
    "frontend/src/**/*.test.{js,ts,jsx,tsx}",
    "frontend/src/test/**/*.{js,ts,jsx,tsx}",
    // Shared component libraries intentionally expose all exports.
    "frontend/src/components/ui/**/*.{js,jsx,ts,tsx}",
    "frontend/src/components/design-system/**/*.{ts,tsx}",
    "frontend/src/components/**/*.mdx",
    "frontend/src/components/**/*.stories.tsx",
    "frontend/src/components/Storybook/**/*.{ts,tsx}",
    "frontend/.storybook/**/*.{ts,tsx}",
    "frontend/storybook-tests/**/*.ts",
    "frontend/openapi-ts.config.ts",
    // Storybook-only fixtures also remain roots in the production analysis.
    "frontend/src/components/Repository/diff-fixtures.ts",
    "frontend/src/components/Repository/tracker-story-fixtures.ts",
    // React Email discovers templates by convention.
    "packages/react-email/emails/**/*.tsx"
  ],
  "ignorePatterns": [
    // Generated by OpenAPI and TanStack Router, respectively.
    "frontend/src/client/**",
    "frontend/src/routeTree.gen.ts"
  ],
  "ignoreDependencies": [
    // Dynamically resolved by the React Email CLI for the preview server.
    "@react-email/ui"
  ],
  "rules": {
    // Match Knip's disabled enum member check and gating of dev dependencies.
    "unused-enum-members": "off",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    // Additional dependency/class checks, as in the reference config.
    "unused-class-members": "warn",
    "dev-dependencies-in-production": "warn"
  }
}

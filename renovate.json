{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jan-mue/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "bun"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchPackageNames": [
        "bun",
        "oven/bun"
      ],
      "groupName": "Bun runtime"
    },
    {
      "matchPackageNames": [
        "docker/dockerfile"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/backend/tests/integration/agents/containers\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_IMAGE = \"[^\"\\n]+:(?<currentValue>[^\"\\n]+)\""
      ],
      "versioningTemplate": "docker"
    }
  ]
}

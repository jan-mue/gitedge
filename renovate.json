{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jan-mue/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "bun"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchPackageNames": [
        "bun",
        "oven/bun"
      ],
      "groupName": "Bun runtime"
    }
  ]
}

{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "lint": "bun run --filter frontend --filter @gitedge/actions-* lint",
    "test": "bun run test:frontend && bun run test:actions",
    "test:ui": "bun run --filter frontend test:ui",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export",
    "fallow": "fallow --fail-on-issues",
    "test:frontend": "vitest run --project frontend",
    "test:actions": "bun --bun vitest run --project actions-runner --project actions-compiler",
    "typecheck:actions": "bun run --filter @gitedge/actions-* typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "css-tree": "3.2.1",
    "fallow": "3.36.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "jose": "5.10.0"
  },
  "packageManager": "bun@1.4.4",
  "type": "module"
}

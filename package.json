{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "lint": "bun run --filter frontend --filter @gitedge/actions-runner lint",
    "test": "bun run --filter frontend --filter @gitedge/actions-runner test",
    "test:ui": "bun run --filter frontend test:ui",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "knip": "6.41.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
